    <owl:NamedIndividual rdf:about="https://w3id.org/celine-eu#NoticeConstraint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Constraint on the minimum lead time required before activating flexibility.</rdfs:comment>
