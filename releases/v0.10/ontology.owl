    <owl:NamedIndividual rdf:about="https://w3id.org/celine-eu#GridImportEnergy">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <rdfs:comment xml:lang="en">Electrical energy drawn from the distribution grid over the observation interval (IT: prelievo). At community scope this is the sum over the members netted together. celine:WithdrawnEnergy is the period-total KPI over this property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/celine-eu"/>
        <rdfs:label xml:lang="it">Energia prelevata</rdfs:label>
        <rdfs:label xml:lang="en">Grid import energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/celine-eu#WithdrawnEnergy"/>
