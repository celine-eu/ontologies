    <!-- https://w3id.org/celine-eu#GridExportEnergy -->


    <owl:NamedIndividual rdf:about="https://w3id.org/celine-eu#GridExportEnergy">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <rdfs:comment xml:lang="en">Electrical energy fed into the distribution grid over the observation interval (IT: immissione). Producers and prosumers only. celine:FedInEnergy is the period-total KPI over this property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/celine-eu"/>
        <rdfs:label xml:lang="it">Energia immessa</rdfs:label>
        <rdfs:label xml:lang="en">Grid export energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/celine-eu#FedInEnergy"/>
        <skos:prefLabel xml:lang="en">Grid export energy</skos:prefLabel>
    </owl:NamedIndividual>
    


