        <skos:topConceptOf rdf:resource="https://w3id.org/celine-eu#KPICatalog"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/celine-eu#RecoveryConstraint -->


    <owl:NamedIndividual rdf:about="https://w3id.org/celine-eu#RecoveryConstraint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Constraint on the minimum rest period required between consecutive flexibility activations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/celine-eu"/>
        <skos:inScheme rdf:resource="https://w3id.org/celine-eu#ConstraintType"/>
        <skos:prefLabel xml:lang="en">Recovery Constraint</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/celine-eu#ConstraintType"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/celine-eu#RequestCancelled -->


