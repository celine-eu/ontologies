        <skos:topConceptOf rdf:resource="https://w3id.org/celine-eu#RequestStatus"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/celine-eu#RequestPartial -->


    <owl:NamedIndividual rdf:about="https://w3id.org/celine-eu#RequestPartial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Some commitments received but total falls below the requested target.</rdfs:comment>
