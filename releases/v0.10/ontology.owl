        <rdfs:label xml:lang="it">Incentivo maturato</rdfs:label>
        <skos:definition xml:lang="en">Total monetary incentive accrued by the community for shared energy during the evaluation period.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/celine-eu#KPICatalog"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/celine-eu#KPICatalog"/>
    </owl:NamedIndividual>
    


