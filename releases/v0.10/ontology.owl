    <owl:NamedIndividual rdf:about="https://w3id.org/celine-eu#RequestExpired">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Activation window passed without sufficient response.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/celine-eu"/>
        <skos:inScheme rdf:resource="https://w3id.org/celine-eu#RequestStatus"/>
