        <skos:hasTopConcept rdf:resource="https://w3id.org/celine-eu#SelfConsumptionRate"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/celine-eu#SelfSufficiencyRate"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/celine-eu#SharedEnergy"/>
