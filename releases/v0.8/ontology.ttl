@prefix : <https://w3id.org/celine-eu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/celine-eu#> .

<https://w3id.org/celine-eu> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/celine-eu/v0.8> ;
                              owl:imports <https://purl.org/peco/peco-core> ,
                                          <https://raw.githubusercontent.com/w3c/sdw/dee1bdd3c339d8a0ab512c7f9bc97a08912ad7d6/ssn/integrated/sosa.ttl> ,
                                          <https://saref.etsi.org/core/v3.1.1/saref.ttl> ,
                                          <https://saref.etsi.org/saref4ener/v1.2.1/saref4ener.ttl> ;
                              <http://purl.org/dc/terms/created> "2026-03-24"^^xsd:date ;
                              <http://purl.org/dc/terms/description> """The CELINE Core Ontology is a lightweight orchestration profile for
    Renewable Energy Communities (RECs) and Digital Twin workflows. It connects established
    standards — PECO, SAREF, SAREF4ENER, SOSA/SSN — without redefining their domain
    semantics, providing a minimal coordination layer for simulation scenarios, dataset
    references, KPI definition and evaluation, and REC flexibility commitment and settlement.""" ;
                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                              <http://purl.org/dc/terms/modified> "2026-08-08"^^xsd:date ;
                              <http://purl.org/dc/terms/title> "CELINE Core Ontology" ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "celine" ;
                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/celine-eu#" ;
                              rdfs:comment """Version 0.6 adds registry-aligned grid topology (Substation,
    PrimarySubstation, SecondarySubstation, PowerTransformer, DistributionFeeder),
    regulatory zones, the GridOperator actor, a generalised ConnectionPoint superclass
    for PECO Electric_POD, a presence-only asset inventory (PVSystem, BatteryStorage,
    ElectricityMeter, EVCharger, HeatPump), member modeling (hasMember linkage, MemberRole
    and MemberStatus vocabularies, hasDeliveryPoint for member-to-POD linkage), and
    SharingGroup — a community partition for shared self-consumption accounting within a
    regulatory zone, aligned with the RED II (2018/2001) double-counting prohibition.
    CIM alignment via skos:closeMatch to IEC 61968 profile; SAREF alignment via
    skos:closeMatch only — no new owl:imports. Asset technical attributes are intentionally
    omitted; specs live in an external catalogue, addressed by celine:hasLocalIdentifier.
    Version 0.7 adds hasDataset (asset/connection-point → DatasetReference) as the
    operational counterpart to the SimulationRun-scoped usesDataset/producesDataset;
    clarifies DatasetReference self-description via DCAT/DCT terms; generalises
    external-catalogue wording to remove implementation-specific naming.
    Version 0.8 is a conformance fix, no new terms: the CommitmentMode,
    FlexibilityDirection, CostType and ConstraintType schemes gain the
    skos:hasTopConcept assertions their SHACL shapes require — the concepts already
    declared skos:inScheme and skos:topConceptOf, so only the scheme-side statement
    was missing. All four schemes are flat, so every member is a top concept. Their
    labels, prefLabels, descriptions and comments also gain the @en tag the other
    nine schemes already carry.""" ;
                              rdfs:label "CELINE Core Ontology" ;
                              rdfs:seeAlso <https://celine-eu.github.io/> ,
                                           <https://github.com/celine-eu> ,
                                           <https://www.celineproject.eu/> ;
                              owl:priorVersion <https://w3id.org/celine-eu/v0.7> ;
                              owl:versionInfo "0.8.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
<http://www.w3.org/2004/02/skos/core#hasTopConcept> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
<http://www.w3.org/2004/02/skos/core#notation> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
<http://www.w3.org/2004/02/skos/core#relatedMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
<http://www.w3.org/2004/02/skos/core#topConceptOf> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/celine-eu#committedBy
:committedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :FlexibilityCommitment ;
             rdfs:range <https://purl.org/peco/peco-core#Energy_community_member> ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "committed by" .


###  https://w3id.org/celine-eu#creditFor
:creditFor rdf:type owl:ObjectProperty ;
           owl:inverseOf :generatesCredit ;
           rdfs:domain :FlexibilityCredit ;
           rdfs:range :FlexibilityCommitment ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "credit for" .


###  https://w3id.org/celine-eu#earnedBy
:earnedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :FlexibilityCredit ;
          rdfs:range <https://purl.org/peco/peco-core#Energy_community_member> ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "earned by" .


###  https://w3id.org/celine-eu#envelopeFor
:envelopeFor rdf:type owl:ObjectProperty ;
             rdfs:domain :FlexibilityEnvelope ;
             rdfs:range :ConnectionPoint ;
             rdfs:comment "The connection point whose physical and operational flexibility is described by this envelope. Accepts any celine:ConnectionPoint subclass (including peco:Electric_POD)." ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "envelope for" .


###  https://w3id.org/celine-eu#evidencedBy
:evidencedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :FlexibilityCredit ;
             rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
             rdfs:comment "SOSA observation(s) that meter the actual flexibility delivered, grounding the credit in measured data." ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "evidenced by" .


###  https://w3id.org/celine-eu#generatesCredit
:generatesCredit rdf:type owl:ObjectProperty ;
                 rdfs:domain :FlexibilityCommitment ;
                 rdfs:range :FlexibilityCredit ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "generates credit" .


###  https://w3id.org/celine-eu#hasAvailabilityWindow
:hasAvailabilityWindow rdf:type owl:ObjectProperty ;
                       rdfs:domain :FlexibilityEnvelope ;
                       rdfs:range <http://www.w3.org/2006/time#Interval> ;
                       rdfs:comment "Time window(s) during which the flexibility declared in this envelope is available for activation." ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "has availability window" .


###  https://w3id.org/celine-eu#hasCommitment
:hasCommitment rdf:type owl:ObjectProperty ;
               rdfs:domain :CommunityContext ;
               rdfs:range :FlexibilityCommitment ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "has flexibility commitment" .


###  https://w3id.org/celine-eu#hasCommitmentMode
:hasCommitmentMode rdf:type owl:ObjectProperty ;
                   rdfs:domain :FlexibilityCommitment ;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:comment "Expected values: celine:Automated or celine:Voluntary." ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "has commitment mode" .


###  https://w3id.org/celine-eu#hasCommunity
:hasCommunity rdf:type owl:ObjectProperty ;
              rdfs:domain :CommunityContext ;
              rdfs:range <https://purl.org/peco/peco-core#EnergyCommunity> ;
              rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
              rdfs:label "has energy community" .


###  https://w3id.org/celine-eu#hasConstraint
:hasConstraint rdf:type owl:ObjectProperty ;
               rdfs:domain :FlexibilityEnvelope ;
               rdfs:range :FlexibilityConstraint ;
               rdfs:comment "One or more operational constraints bounding how flexibility in this envelope may be activated." ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "has constraint" .


###  https://w3id.org/celine-eu#hasConstraintType
:hasConstraintType rdf:type owl:ObjectProperty ;
                   rdfs:domain :FlexibilityConstraint ;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:comment "Expected values: celine:DurationConstraint, celine:NoticeConstraint, celine:RecoveryConstraint, celine:FrequencyConstraint." ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "has constraint type" .


###  https://w3id.org/celine-eu#hasCostItem
:hasCostItem rdf:type owl:ObjectProperty ;
             rdfs:domain :SettlementRun ;
             rdfs:range :CostItem ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "has cost item" .


###  https://w3id.org/celine-eu#hasCostType
:hasCostType rdf:type owl:ObjectProperty ;
             rdfs:domain :CostItem ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
             rdfs:comment "Expected values: celine:AdminCost, celine:Fee, or celine:Debt." ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "has cost type" .


###  https://w3id.org/celine-eu#hasDataset
:hasDataset rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( <https://purl.org/peco/peco-core#Asset>
                                        :ConnectionPoint
                                      )
                        ] ;
            rdfs:range :DatasetReference ;
            rdfs:comment "Links an asset or connection point to an external, self-describing datasource carrying its data (e.g. metered time-series). CELINE does not define the datasource schema; the referenced dataset declares its own conformance via dct:conformsTo. Operational counterpart to the SimulationRun-scoped usesDataset/producesDataset."@en ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "has dataset"@en .


###  https://w3id.org/celine-eu#hasDeliveryPoint
:hasDeliveryPoint rdf:type owl:ObjectProperty ;
                  rdfs:domain <https://purl.org/peco/peco-core#Energy_community_member> ;
                  rdfs:range :ConnectionPoint ;
                  rdfs:comment "A connection point (POD, CUPS, PRM, etc.) through which this member withdraws or injects energy. Mirrors the upstream registry's member delivery-points list."@en ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "has delivery point"@en .


###  https://w3id.org/celine-eu#hasEnvelope
:hasEnvelope rdf:type owl:ObjectProperty ;
             rdfs:domain :CommunityContext ;
             rdfs:range :FlexibilityEnvelope ;
             rdfs:comment "Links a CommunityContext to the declared flexibility capability envelopes of its PODs." ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "has flexibility envelope" .


###  https://w3id.org/celine-eu#hasEvaluatedScope
:hasEvaluatedScope rdf:type owl:ObjectProperty ;
                   rdfs:domain :KPIEvaluation ;
                   rdfs:range [ rdf:type owl:Class ;
                                owl:unionOf ( <https://purl.org/peco/peco-core#Energy_community_member>
                                              :CommunityContext
                                              :ConnectionPoint
                                            )
                              ] ;
                   rdfs:comment "The entity (community, member, or POD) for which this KPI was evaluated."@en ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "has evaluated scope"@en .


###  https://w3id.org/celine-eu#hasEvaluationTimeInterval
:hasEvaluationTimeInterval rdf:type owl:ObjectProperty ;
                           rdfs:domain :KPIEvaluation ;
                           rdfs:range <http://www.w3.org/2006/time#Interval> ;
                           rdfs:comment "The time interval over which the KPI was evaluated."@en ;
                           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                           rdfs:label "has evaluation time interval"@en .


###  https://w3id.org/celine-eu#hasFlexibilityDirection
:hasFlexibilityDirection rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :FlexibilityCommitment
                                                     :FlexibilityRequest
                                                   )
                                     ] ;
                         rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                         rdfs:comment "Expected values: celine:FlexDown or celine:FlexUp."@en ;
                         rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                         rdfs:label "has flexibility direction" .


###  https://w3id.org/celine-eu#hasFlexibilityRequest
:hasFlexibilityRequest rdf:type owl:ObjectProperty ;
                       rdfs:domain :CommunityContext ;
                       rdfs:range :FlexibilityRequest ;
                       rdfs:comment "A flexibility request issued within this community context."@en ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "has flexibility request"@en .


###  https://w3id.org/celine-eu#hasGridOperator
:hasGridOperator rdf:type owl:ObjectProperty ;
                 rdfs:domain :CommunityContext ;
                 rdfs:range :GridOperator ;
                 rdfs:comment "The grid operator(s) serving this community context."@en ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "has grid operator"@en .


###  https://w3id.org/celine-eu#hasIdentifierScheme
:hasIdentifierScheme rdf:type owl:ObjectProperty ;
                     rdfs:domain :ConnectionPoint ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     rdfs:comment "The national identifier scheme for this connection point. Expected values from celine:ConnectionPointIdentifierScheme."@en ;
                     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                     rdfs:label "has identifier scheme"@en .


###  https://w3id.org/celine-eu#hasInputKPIEvaluation
:hasInputKPIEvaluation rdf:type owl:ObjectProperty ;
                       rdfs:domain :KPIEvaluation ;
                       rdfs:range :KPIEvaluation ;
                       rdfs:comment "Upstream KPI evaluation(s) used as input for computing a derived KPI."@en ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "has input KPI evaluation"@en .


###  https://w3id.org/celine-eu#hasInputObservation
:hasInputObservation rdf:type owl:ObjectProperty ;
                     rdfs:domain :KPIEvaluation ;
                     rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                     rdfs:comment "SOSA observation(s) used as input data for computing this KPI evaluation."@en ;
                     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                     rdfs:label "has input observation"@en .


###  https://w3id.org/celine-eu#hasKPICalculationMethod
:hasKPICalculationMethod rdf:type owl:ObjectProperty ;
                         rdfs:domain :KPIDefinition ;
                         rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                         rdfs:comment "Expected values from celine:KPICalculationMethod concept scheme."@en ;
                         rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                         rdfs:label "has KPI calculation method"@en .


###  https://w3id.org/celine-eu#hasKPIDefinition
:hasKPIDefinition rdf:type owl:ObjectProperty ;
                  rdfs:domain :KPIEvaluation ;
                  rdfs:range :KPIDefinition ;
                  rdfs:comment "Links an evaluation to the KPI type being measured."@en ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "has KPI definition"@en .


###  https://w3id.org/celine-eu#hasKPIEvaluation
:hasKPIEvaluation rdf:type owl:ObjectProperty ;
                  rdfs:domain :SimulationRun ;
                  rdfs:range :KPIEvaluation ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "has KPI evaluation" .


###  https://w3id.org/celine-eu#hasKPIScopeType
:hasKPIScopeType rdf:type owl:ObjectProperty ;
                 rdfs:domain :KPIDefinition ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "Expected values from celine:KPIScope concept scheme."@en ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "has KPI scope type"@en .


###  https://w3id.org/celine-eu#hasKPITemporalGranularity
:hasKPITemporalGranularity rdf:type owl:ObjectProperty ;
                           rdfs:domain :KPIDefinition ;
                           rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                           rdfs:comment "Expected values from celine:KPITemporalGranularity concept scheme."@en ;
                           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                           rdfs:label "has KPI temporal granularity"@en .


###  https://w3id.org/celine-eu#hasKPIUnit
:hasKPIUnit rdf:type owl:ObjectProperty ;
            rdfs:domain :KPIDefinition ;
            rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
            rdfs:comment "Unit of measure for the KPI value. Expected values from celine:UnitOfMeasure concept scheme."@en ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "has KPI unit"@en .


###  https://w3id.org/celine-eu#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :CommunityContext
                                       :SharingGroup
                                     )
                       ] ;
           rdfs:range <https://purl.org/peco/peco-core#Energy_community_member> ;
           rdfs:comment "A member participating in this community context or sharing group. When used on a SharingGroup, enumerates the members whose energy flows are accounted within that partition. The reciprocal PECO link from the member to the wrapped peco:Energy_community is peco:is_member_of. Population rule: every member listed under a SharingGroup SHOULD also be listed under the parent CommunityContext via hasMember; no owl:propertyChainAxiom is asserted — implementors must replicate the membership link explicitly."@en ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "has member"@en .


###  https://w3id.org/celine-eu#hasMemberRole
:hasMemberRole rdf:type owl:ObjectProperty ;
               rdfs:domain <https://purl.org/peco/peco-core#Energy_community_member> ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "The participation role of this member within their energy community. Expected values from celine:MemberRole. Following the upstream registry conceptual model, a member has exactly one role per community; cross-community role differences are out of scope."@en ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "has member role"@en .


###  https://w3id.org/celine-eu#hasMemberStatus
:hasMemberStatus rdf:type owl:ObjectProperty ;
                 rdfs:domain <https://purl.org/peco/peco-core#Energy_community_member> ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "The lifecycle status of this member within their energy community. Expected values from celine:MemberStatus. Following the upstream registry conceptual model, a member has exactly one status per community."@en ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "has member status"@en .


###  https://w3id.org/celine-eu#hasPartition
:hasPartition rdf:type owl:ObjectProperty ;
              rdfs:domain :CommunityContext ;
              rdfs:range :SharingGroup ;
              rdfs:comment "A sharing group partition within this community context. Each partition covers one regulatory zone and enumerates the members whose energy flows are accounted together for shared self-consumption."@en ;
              rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
              rdfs:label "has partition"@en .


###  https://w3id.org/celine-eu#hasRedistributionResult
:hasRedistributionResult rdf:type owl:ObjectProperty ;
                         rdfs:domain :SettlementRun ;
                         rdfs:range :RedistributionResult ;
                         rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                         rdfs:label "has redistribution result" .


###  https://w3id.org/celine-eu#hasRegulatoryZone
:hasRegulatoryZone rdf:type owl:ObjectProperty ;
                   rdfs:domain :CommunityContext ;
                   rdfs:range :RegulatoryZone ;
                   rdfs:comment "The regulatory zone(s) covered by this community context."@en ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "has regulatory zone"@en .


###  https://w3id.org/celine-eu#hasRequestStatus
:hasRequestStatus rdf:type owl:ObjectProperty ;
                  rdfs:domain :FlexibilityRequest ;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "Expected values from celine:RequestStatus."@en ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "has request status"@en .


###  https://w3id.org/celine-eu#hasScenario
:hasScenario rdf:type owl:ObjectProperty ;
             rdfs:domain :Simulation ;
             rdfs:range :Scenario ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "has scenario" .


###  https://w3id.org/celine-eu#hasSettlementRun
:hasSettlementRun rdf:type owl:ObjectProperty ;
                  rdfs:domain :CommunityContext ;
                  rdfs:range :SettlementRun ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "has settlement run" .


###  https://w3id.org/celine-eu#hasSimulation
:hasSimulation rdf:type owl:ObjectProperty ;
               rdfs:domain :CommunityContext ;
               rdfs:range :Simulation ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "has simulation" .


###  https://w3id.org/celine-eu#hasSimulationRun
:hasSimulationRun rdf:type owl:ObjectProperty ;
                  rdfs:domain :Simulation ;
                  rdfs:range :SimulationRun ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "has simulation run" .


###  https://w3id.org/celine-eu#hasTimeInterval
:hasTimeInterval rdf:type owl:ObjectProperty ;
                 rdfs:range <http://www.w3.org/2006/time#Interval> ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "has time interval" .


###  https://w3id.org/celine-eu#hasTopologyNode
:hasTopologyNode rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :CommunityContext
                                             :SharingGroup
                                           )
                             ] ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :DistributionFeeder
                                            :PowerTransformer
                                            :Substation
                                          )
                            ] ;
                 rdfs:comment "A grid topology element associated with this community context or sharing group."@en ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "has topology node"@en .


###  https://w3id.org/celine-eu#inRegulatoryZone
:inRegulatoryZone rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( <https://purl.org/peco/peco-core#Energy_community_member>
                                              :ConnectionPoint
                                              :SharingGroup
                                            )
                              ] ;
                  rdfs:range :RegulatoryZone ;
                  rdfs:comment "The regulatory zone to which this member, connection point, or sharing group belongs."@en ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "in regulatory zone"@en .


###  https://w3id.org/celine-eu#inResponseTo
:inResponseTo rdf:type owl:ObjectProperty ;
              owl:inverseOf :resultsInCommitment ;
              rdfs:domain :FlexibilityCommitment ;
              rdfs:range :FlexibilityRequest ;
              rdfs:comment "The flexibility request that triggered this commitment."@en ;
              rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
              rdfs:label "in response to"@en .


###  https://w3id.org/celine-eu#measures
:measures rdf:type owl:ObjectProperty ;
          rdfs:domain :ElectricityMeter ;
          rdfs:range <https://purl.org/peco/peco-core#Asset> ;
          rdfs:comment "The asset whose energy flows are metered by this electricity meter."@en ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "measures"@en .


###  https://w3id.org/celine-eu#onPOD
:onPOD rdf:type owl:ObjectProperty ;
       rdfs:domain :FlexibilityCommitment ;
       rdfs:range :ConnectionPoint ;
       rdfs:comment "One or more connection points through which the committed flexibility is provided. Accepts any celine:ConnectionPoint subclass (including peco:Electric_POD)." ;
       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
       rdfs:label "on POD" .


###  https://w3id.org/celine-eu#operatedBy
:operatedBy rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :DistributionFeeder
                                        :PowerTransformer
                                        :Substation
                                      )
                        ] ;
            rdfs:range :GridOperator ;
            rdfs:comment "The grid operator responsible for this infrastructure element."@en ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "operated by"@en .


###  https://w3id.org/celine-eu#pairedWith
:pairedWith rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty ;
            rdfs:domain <https://purl.org/peco/peco-core#Asset> ;
            rdfs:range <https://purl.org/peco/peco-core#Asset> ;
            rdfs:comment "Symmetric link between co-located or functionally coupled assets (e.g. PV system paired with battery storage)."@en ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "paired with"@en .


###  https://w3id.org/celine-eu#partitionOf
:partitionOf rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasPartition ;
             rdfs:domain :SharingGroup ;
             rdfs:range :CommunityContext ;
             rdfs:comment "The community context to which this sharing group belongs."@en ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "partition of"@en .


###  https://w3id.org/celine-eu#producesDataset
:producesDataset rdf:type owl:ObjectProperty ;
                 rdfs:domain :SimulationRun ;
                 rdfs:range :DatasetReference ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "produces dataset" .


###  https://w3id.org/celine-eu#requestedBy
:requestedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :FlexibilityRequest ;
             rdfs:range <https://purl.org/peco/peco-core#Agent> ;
             rdfs:comment "The operator or automated system that issued this flexibility request."@en ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "requested by"@en .


###  https://w3id.org/celine-eu#resultFor
:resultFor rdf:type owl:ObjectProperty ;
           rdfs:domain :RedistributionResult ;
           rdfs:range <https://purl.org/peco/peco-core#Energy_community_member> ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "result for" .


###  https://w3id.org/celine-eu#resultsInCommitment
:resultsInCommitment rdf:type owl:ObjectProperty ;
                     rdfs:domain :FlexibilityRequest ;
                     rdfs:range :FlexibilityCommitment ;
                     rdfs:comment "FlexibilityCommitment(s) created in response to this request."@en ;
                     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                     rdfs:label "results in commitment"@en .


###  https://w3id.org/celine-eu#servedBy
:servedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :RegulatoryZone ;
          rdfs:range :Substation ;
          rdfs:comment "The substation(s) that serve this regulatory zone."@en ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "served by"@en .


###  https://w3id.org/celine-eu#settlesContext
:settlesContext rdf:type owl:ObjectProperty ;
                owl:inverseOf :hasSettlementRun ;
                rdfs:domain :SettlementRun ;
                rdfs:range :CommunityContext ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "settles context" .


###  https://w3id.org/celine-eu#usesAsset
:usesAsset rdf:type owl:ObjectProperty ;
           rdfs:domain :CommunityContext ;
           rdfs:range <https://saref.etsi.org/core/Device> ;
           rdfs:comment "References SAREF or SAREF4ENER devices." ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "uses asset" .


###  https://w3id.org/celine-eu#usesDataset
:usesDataset rdf:type owl:ObjectProperty ;
             rdfs:domain :SimulationRun ;
             rdfs:range :DatasetReference ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "uses dataset" .


###  https://w3id.org/celine-eu#usesObservation
:usesObservation rdf:type owl:ObjectProperty ;
                 rdfs:domain :SimulationRun ;
                 rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                 rdfs:comment "References SOSA observations (e.g. weather, sensors)." ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "uses observation" .


###  https://w3id.org/celine-eu#withinEnvelope
:withinEnvelope rdf:type owl:ObjectProperty ;
                rdfs:domain :FlexibilityCommitment ;
                rdfs:range :FlexibilityEnvelope ;
                rdfs:comment "The FlexibilityEnvelope from which this commitment draws; commitment amounts must not exceed envelope bounds." ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "within envelope" .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/celine-eu#availableEnergy
:availableEnergy rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FlexibilityEnvelope ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Total energy available for flexibility delivery within the availability window (kWh)." ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "available energy" .


###  https://w3id.org/celine-eu#conversionRate
:conversionRate rdf:type owl:DatatypeProperty ;
                rdfs:domain :SettlementRun ;
                rdfs:range xsd:decimal ;
                rdfs:comment "Monetary value per kWh of flexibility credit (e.g., EUR/kWh). Applied uniformly to all members in this settlement period." ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "conversion rate" .


###  https://w3id.org/celine-eu#costAmount
:costAmount rdf:type owl:DatatypeProperty ;
            rdfs:domain :CostItem ;
            rdfs:range xsd:decimal ;
            rdfs:comment "Monetary amount of this cost voice, in the currency of the enclosing SettlementRun." ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "cost amount" .


###  https://w3id.org/celine-eu#costDeduction
:costDeduction rdf:type owl:DatatypeProperty ;
               rdfs:domain :RedistributionResult ;
               rdfs:range xsd:decimal ;
               rdfs:comment "Member's allocated share of the total SettlementRun CostItems." ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "cost deduction" .


###  https://w3id.org/celine-eu#creditAmount
:creditAmount rdf:type owl:DatatypeProperty ;
              rdfs:domain :FlexibilityCredit ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Flexibility actually delivered, in kWh. May be less than or equal to the commitment's targetFlexibility." ;
              rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
              rdfs:label "credit amount" .


###  https://w3id.org/celine-eu#creditBalance
:creditBalance rdf:type owl:DatatypeProperty ;
               rdfs:domain :RedistributionResult ;
               rdfs:range xsd:decimal ;
               rdfs:comment "Total flexibility credits (kWh) accumulated by this member in the settlement period." ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "credit balance" .


###  https://w3id.org/celine-eu#currency
:currency rdf:type owl:DatatypeProperty ;
          rdfs:domain :SettlementRun ;
          rdfs:range xsd:string ;
          rdfs:comment "ISO 4217 currency code for all monetary amounts in this settlement (e.g., 'EUR')." ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "currency" .


###  https://w3id.org/celine-eu#grossAmount
:grossAmount rdf:type owl:DatatypeProperty ;
             rdfs:domain :RedistributionResult ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Monetary value of the member's credit balance before cost deductions (creditBalance x conversionRate)." ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "gross amount" .


###  https://w3id.org/celine-eu#hasKPIDescription
:hasKPIDescription rdf:type owl:DatatypeProperty ;
                   rdfs:domain :KPIDefinition ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Free-text description of the KPI. Use xml:lang tagging for multilingual descriptions."@en ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "has KPI description"@en .


###  https://w3id.org/celine-eu#hasKPIFormula
:hasKPIFormula rdf:type owl:DatatypeProperty ;
               rdfs:domain :KPIDefinition ;
               rdfs:range xsd:string ;
               rdfs:comment "Optional free-text or MathML representation of the KPI calculation formula."@en ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "has KPI formula"@en .


###  https://w3id.org/celine-eu#hasKPIName
:hasKPIName rdf:type owl:DatatypeProperty ;
            rdfs:domain :KPIDefinition ;
            rdfs:range xsd:string ;
            rdfs:comment "Canonical name of the KPI. For multilingual names use rdfs:label with language tags."@en ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "has KPI name"@en .


###  https://w3id.org/celine-eu#hasKPIValue
:hasKPIValue rdf:type owl:DatatypeProperty ;
             rdfs:domain :KPIEvaluation ;
             rdfs:range xsd:decimal ;
             rdfs:comment "The computed numeric value of the KPI for this evaluation."@en ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "has KPI value"@en .


###  https://w3id.org/celine-eu#hasLocalIdentifier
:hasLocalIdentifier rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <https://purl.org/peco/peco-core#Asset>
                                                :ConnectionPoint
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Local identifier string. For connection points: the national metering code (POD, CUPS, PRM, etc.). For assets: the registry's local asset key, used as the lookup handle into an external catalogue."@en ;
                    rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                    rdfs:label "has local identifier"@en .


###  https://w3id.org/celine-eu#maxActivationDuration
:maxActivationDuration rdf:type owl:DatatypeProperty ;
                       rdfs:domain :FlexibilityConstraint ;
                       rdfs:range xsd:duration ;
                       rdfs:comment "Maximum duration for which a flexibility activation may be maintained (ISO 8601 duration, e.g. PT4H)." ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "max activation duration" .


###  https://w3id.org/celine-eu#maxActivationsPerDay
:maxActivationsPerDay rdf:type owl:DatatypeProperty ;
                      rdfs:domain :FlexibilityConstraint ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Maximum number of flexibility activation events permitted within a 24-hour period." ;
                      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                      rdfs:label "max activations per day" .


###  https://w3id.org/celine-eu#maxFlexDown
:maxFlexDown rdf:type owl:DatatypeProperty ;
             rdfs:domain :FlexibilityEnvelope ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Maximum downward flexibility available from this envelope (kW). Positive value; represents decrease in net load or increase in local generation." ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "max flex down" .


###  https://w3id.org/celine-eu#maxFlexUp
:maxFlexUp rdf:type owl:DatatypeProperty ;
           rdfs:domain :FlexibilityEnvelope ;
           rdfs:range xsd:decimal ;
           rdfs:comment "Maximum upward flexibility available from this envelope (kW). Positive value; represents increase in net load or decrease in local generation." ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "max flex up" .


###  https://w3id.org/celine-eu#minActivationDuration
:minActivationDuration rdf:type owl:DatatypeProperty ;
                       rdfs:domain :FlexibilityConstraint ;
                       rdfs:range xsd:duration ;
                       rdfs:comment "Minimum duration for which a flexibility activation must be sustained once started (ISO 8601 duration, e.g. PT30M)." ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "min activation duration" .


###  https://w3id.org/celine-eu#minNotificationTime
:minNotificationTime rdf:type owl:DatatypeProperty ;
                     rdfs:domain :FlexibilityConstraint ;
                     rdfs:range xsd:duration ;
                     rdfs:comment "Minimum lead time required before a flexibility activation can start (ISO 8601 duration, e.g. PT15M)." ;
                     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                     rdfs:label "min notification time" .


###  https://w3id.org/celine-eu#minRecoveryTime
:minRecoveryTime rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FlexibilityConstraint ;
                 rdfs:range xsd:duration ;
                 rdfs:comment "Minimum rest period required between two consecutive flexibility activations (ISO 8601 duration, e.g. PT1H)." ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "min recovery time" .


###  https://w3id.org/celine-eu#netAmount
:netAmount rdf:type owl:DatatypeProperty ;
           rdfs:domain :RedistributionResult ;
           rdfs:range xsd:decimal ;
           rdfs:comment "Final redistribution amount for this member (grossAmount - costDeduction)." ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "net amount" .


###  https://w3id.org/celine-eu#requestedFlexibility
:requestedFlexibility rdf:type owl:DatatypeProperty ;
                      rdfs:domain :FlexibilityRequest ;
                      rdfs:range xsd:decimal ;
                      rdfs:comment "Target flexibility amount in kWh. Positive value; direction is expressed by hasFlexibilityDirection."@en ;
                      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                      rdfs:label "requested flexibility"@en .


###  https://w3id.org/celine-eu#targetFlexibility
:targetFlexibility rdf:type owl:DatatypeProperty ;
                   rdfs:domain :FlexibilityCommitment ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "Committed flexibility amount in kWh. Positive value; direction is expressed by hasFlexibilityDirection." ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "target flexibility" .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://purl.org/peco/peco-core#Electric_POD
<https://purl.org/peco/peco-core#Electric_POD> rdfs:subClassOf :ConnectionPoint .


###  https://purl.org/peco/peco-core#EnergyCommunity
<https://purl.org/peco/peco-core#EnergyCommunity> rdf:type owl:Class .


###  https://w3id.org/celine-eu#BatteryStorage
:BatteryStorage rdf:type owl:Class ;
                rdfs:subClassOf <https://purl.org/peco/peco-core#Energy_storage> ;
                rdfs:comment "A battery energy storage system. Technical attributes live in an external catalogue."@en ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "Battery Storage"@en ;
                <http://www.w3.org/2004/02/skos/core#closeMatch> <https://saref.etsi.org/core/Device> .


###  https://w3id.org/celine-eu#CommunityContext
:CommunityContext rdf:type owl:Class ;
                  rdfs:comment """Operational context binding a PECO Energy Community
    with assets, datasets, simulations and flexibility commitments. Member
    participation in this context is enumerated via celine:hasMember; each
    member is linked to the wrapped peco:Energy_community via
    peco:is_member_of (PECO predicate, reused as-is).""" ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "Community Context" ;
                  <http://www.w3.org/2004/02/skos/core#example> """ex:ctx1 a celine:CommunityContext ;
    celine:hasCommunity    ex:rec_valdarno ;
    celine:hasMember       ex:member_001 , ex:member_002 ;
    celine:usesAsset       ex:pv_panel_01 ;
    celine:hasSimulation   ex:sim_baseline ;
    celine:hasCommitment   ex:fc_001 ;
    celine:hasSettlementRun ex:sr_2025_q3 .""" .


###  https://w3id.org/celine-eu#ConnectionPoint
:ConnectionPoint rdf:type owl:Class ;
                 rdfs:comment "A generalised point where a consumer or prosumer connects to the distribution grid. Country-specific identifier schemes (POD, CUPS, PRM, etc.) are captured via celine:hasIdentifierScheme. PECO Electric_POD is declared as a subclass."@en ;
                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                 rdfs:label "Connection Point"@en ;
                 <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/UsagePoint> .


###  https://w3id.org/celine-eu#CostItem
:CostItem rdf:type owl:Class ;
          rdfs:comment """A named cost voice within a SettlementRun (e.g., administrative fee,
    platform fee, outstanding debt). Enables transparent cost breakdown before redistribution
    amounts are finalised.""" ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "Cost Item" ;
          <http://www.w3.org/2004/02/skos/core#example> """ex:cost_admin a celine:CostItem ;
    celine:hasCostType  celine:AdminCost ;
    dct:description     \"Community administration fee Q3 2025\" ;
    celine:costAmount   \"120.00\"^^xsd:decimal .

ex:cost_platform_fee a celine:CostItem ;
    celine:hasCostType  celine:Fee ;
    dct:description     \"CELINE platform usage fee Q3 2025\" ;
    celine:costAmount   \"45.00\"^^xsd:decimal .""" .


###  https://w3id.org/celine-eu#DatasetReference
:DatasetReference rdf:type owl:Class ;
                  rdfs:comment """Reference to an external dataset used as input or produced as output.
    CELINE does not define dataset schemas. Instances SHOULD declare their type or
    conformance target (via dct:conformsTo), format (via dct:format), and an access
    location (via dcat:accessURL or dct:source), using DCAT / Dublin Core terms.""" ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "Dataset Reference" ;
                  <http://www.w3.org/2004/02/skos/core#example> """ex:ds_irradiance a celine:DatasetReference ;
    dct:identifier  \"irradiance-2025-07\" ;
    dct:conformsTo  <https://example.org/some-dataset-profile> ;
    dct:format      \"application/json\" ;
    dcat:accessURL  <https://data.example.org/weather/irradiance> .""" .


###  https://w3id.org/celine-eu#DistributionFeeder
:DistributionFeeder rdf:type owl:Class ;
                    rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
                    rdfs:comment "A feeder line distributing power from a substation to downstream connection points."@en ;
                    rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                    rdfs:label "Distribution Feeder"@en ;
                    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/Feeder> .


###  https://w3id.org/celine-eu#EVCharger
:EVCharger rdf:type owl:Class ;
           rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
           rdfs:comment "An electric vehicle charging station. Technical attributes live in an external catalogue."@en ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           rdfs:label "EV Charger"@en ;
           <http://www.w3.org/2004/02/skos/core#closeMatch> <https://saref.etsi.org/core/Device> .


###  https://w3id.org/celine-eu#ElectricityMeter
:ElectricityMeter rdf:type owl:Class ;
                  rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
                  rdfs:comment "A metering device measuring energy flows at a connection point or asset."@en ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "Electricity Meter"@en ;
                  <http://www.w3.org/2004/02/skos/core#closeMatch> <https://saref.etsi.org/core/Device> .


###  https://w3id.org/celine-eu#FlexibilityCommitment
:FlexibilityCommitment rdf:type owl:Class ;
                       rdfs:comment """A member's pledge to provide a specific amount of flexibility
    on one or more of their PODs during a given time window. The commitment can be
    automated (device-driven) or voluntary (manually activated by the member).""" ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "Flexibility Commitment" ;
                       <http://www.w3.org/2004/02/skos/core#example> """ex:fc_001 a celine:FlexibilityCommitment ;
    celine:committedBy              ex:member_rossi ;
    celine:onPOD                    ex:pod_rossi_heatpump ;
    celine:hasCommitmentMode        celine:Automated ;
    celine:hasFlexibilityDirection  celine:FlexDown ;
    celine:targetFlexibility        \"2.5\"^^xsd:decimal ;
    celine:hasTimeInterval          ex:interval_2025_07_01 ;
    celine:generatesCredit          ex:cr_001 .""" .


###  https://w3id.org/celine-eu#FlexibilityConstraint
:FlexibilityConstraint rdf:type owl:Class ;
                       rdfs:comment """Operational constraint governing when and how flexibility declared in a
    FlexibilityEnvelope may be activated. Encodes timing rules (minimum notice period, minimum
    and maximum activation duration, recovery time between activations) and frequency limits.""" ;
                       rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                       rdfs:label "Flexibility Constraint" ;
                       <http://www.w3.org/2004/02/skos/core#example> """ex:constraint_hp a celine:FlexibilityConstraint ;
    celine:hasConstraintType     celine:DurationConstraint ;
    celine:minNotificationTime   \"PT15M\"^^xsd:duration ;
    celine:minActivationDuration \"PT30M\"^^xsd:duration ;
    celine:maxActivationDuration \"PT4H\"^^xsd:duration ;
    celine:minRecoveryTime       \"PT1H\"^^xsd:duration ;
    celine:maxActivationsPerDay  \"3\"^^xsd:integer .""" .


###  https://w3id.org/celine-eu#FlexibilityCredit
:FlexibilityCredit rdf:type owl:Class ;
                   rdfs:comment """Credit awarded to a member for fulfilling (fully or partially)
    a FlexibilityCommitment. Denominated in kWh and backed by metered SOSA observations.
    Credits accumulate until reconciled in a SettlementRun.""" ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "Flexibility Credit" ;
                   <http://www.w3.org/2004/02/skos/core#example> """ex:cr_001 a celine:FlexibilityCredit ;
    celine:earnedBy     ex:member_rossi ;
    celine:creditFor    ex:fc_001 ;
    celine:creditAmount \"2.1\"^^xsd:decimal ;
    celine:evidencedBy  ex:obs_pod_rossi_20250701T10 .""" .


###  https://w3id.org/celine-eu#FlexibilityEnvelope
:FlexibilityEnvelope rdf:type owl:Class ;
                     rdfs:comment """Declared capability of a Point of Delivery (POD) to provide flexibility
    within a given availability window. Captures the physical bounds — maximum upward and downward
    power and available energy — that constrain any FlexibilityCommitment drawn from it.
    Aligned with saref4ener:PowerProfile for device-level scheduling semantics.""" ;
                     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                     rdfs:label "Flexibility Envelope" ;
                     rdfs:seeAlso <https://saref.etsi.org/saref4ener/> ;
                     <http://www.w3.org/2004/02/skos/core#example> """ex:env_hp a celine:FlexibilityEnvelope ;
    celine:envelopeFor           ex:pod_rossi_heatpump ;
    celine:maxFlexUp             \"2.0\"^^xsd:decimal ;
    celine:maxFlexDown           \"3.0\"^^xsd:decimal ;
    celine:availableEnergy       \"6.0\"^^xsd:decimal ;
    celine:hasAvailabilityWindow ex:window_morning ;
    celine:hasConstraint         ex:constraint_hp .""" .


###  https://w3id.org/celine-eu#FlexibilityRequest
:FlexibilityRequest rdf:type owl:Class ;
                    rdfs:comment """A demand signal issued by a community operator or automated system
    requesting members to activate flexibility within a given time window. Specifies the
    desired direction (FlexDown/FlexUp) and target amount. One request may result in zero,
    one, or many FlexibilityCommitments from different members."""@en ;
                    rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                    rdfs:label "Flexibility Request"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> """ex:req_001 a celine:FlexibilityRequest ;
    celine:requestedBy              ex:dso_enel ;
    celine:hasFlexibilityDirection  celine:FlexDown ;
    celine:requestedFlexibility     \"10.0\"^^xsd:decimal ;
    celine:hasTimeInterval          ex:interval_2025_07_01_peak ;
    celine:hasRequestStatus         celine:RequestFulfilled ;
    celine:resultsInCommitment      ex:fc_001 , ex:fc_002 .""" .


###  https://w3id.org/celine-eu#GridOperator
:GridOperator rdf:type owl:Class ;
              rdfs:subClassOf <https://purl.org/peco/peco-core#Agent> ;
              rdfs:comment "An entity that operates grid infrastructure. Typically a Distribution System Operator (DSO). Role-based modelling is deferred; class-based typing is consistent with PECO style."@en ;
              rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
              rdfs:label "Grid Operator"@en ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/Company> .


###  https://w3id.org/celine-eu#HeatPump
:HeatPump rdf:type owl:Class ;
          rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
          rdfs:comment "A heat pump for space heating, cooling, or hot water. Technical attributes live in an external catalogue."@en ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "Heat Pump"@en ;
          <http://www.w3.org/2004/02/skos/core#closeMatch> <https://saref.etsi.org/saref4bldg/HeatPump> .


###  https://w3id.org/celine-eu#KPIDefinition
:KPIDefinition rdf:type owl:Class ;
               rdfs:comment """A definition of a KPI type, independent of any specific evaluation.
    Captures the name, description, formula, unit, scope, calculation method and temporal
    granularity of a KPI. Instances may simultaneously be skos:Concept members of the
    celine:KPICatalog controlled vocabulary."""@en ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "Definizione KPI"@it ,
                          "KPI Definition"@en ;
               <http://www.w3.org/2004/02/skos/core#closeMatch> <https://saref.etsi.org/saref4city/KeyPerformanceIndicator> ;
               <http://www.w3.org/2004/02/skos/core#example> """ex:kpi_def_ssr a celine:KPIDefinition , skos:Concept ;
    skos:inScheme           celine:KPICatalog ;
    celine:hasKPIName       \"Self-Sufficiency Rate\" ;
    celine:hasKPIDescription \"Ratio of locally consumed energy to total consumption.\"@en ;
    celine:hasKPIScopeType           celine:ScopeCommunity ;
    celine:hasKPICalculationMethod   celine:MethodRatio ;
    celine:hasKPITemporalGranularity celine:GranularityPeriod ;
    celine:hasKPIUnit                celine:Dimensionless .""" ;
               <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://bigg-project.eu/bigg4kpi#BuildingKeyPerformanceIndicator> .


###  https://w3id.org/celine-eu#KPIEvaluation
:KPIEvaluation rdf:type owl:Class ;
               rdfs:comment """Evaluation of a KPI for a specific scope entity and time interval.
    References a KPIDefinition for the metric type, and carries the computed value,
    the evaluation period, and optional provenance links to observations or upstream
    KPI evaluations."""@en ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "KPI Evaluation"@en ,
                          "Valutazione KPI"@it ;
               <http://www.w3.org/2004/02/skos/core#closeMatch> <http://bigg-project.eu/bigg4kpi#KPIAssessment> ,
                                                                <https://saref.etsi.org/saref4city/KeyPerformanceIndicatorAssessment> ;
               <http://www.w3.org/2004/02/skos/core#example> """ex:kpi_eval_ssr_q3 a celine:KPIEvaluation ;
    celine:hasKPIDefinition        celine:SelfSufficiencyRate ;
    celine:hasKPIValue             \"0.72\"^^xsd:decimal ;
    celine:hasEvaluationTimeInterval ex:interval_q3_2025 ;
    celine:hasEvaluatedScope       ex:ctx1 ;
    celine:hasInputObservation     ex:obs_meter_001 .""" .


###  https://w3id.org/celine-eu#PVSystem
:PVSystem rdf:type owl:Class ;
          rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
          rdfs:comment "A photovoltaic system. Technical attributes (rated power, panel type, etc.) live in an external catalogue, addressed by celine:hasLocalIdentifier."@en ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "PV System"@en ;
          <http://www.w3.org/2004/02/skos/core#closeMatch> <https://saref.etsi.org/core/Device> .


###  https://w3id.org/celine-eu#PowerTransformer
:PowerTransformer rdf:type owl:Class ;
                  rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
                  rdfs:comment "A transformer within a substation that converts between voltage levels."@en ;
                  rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                  rdfs:label "Power Transformer"@en ;
                  <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/PowerTransformer> .


###  https://w3id.org/celine-eu#PrimarySubstation
:PrimarySubstation rdf:type owl:Class ;
                   rdfs:subClassOf :Substation ;
                   rdfs:comment "HV/MV substation at the boundary between the transmission and distribution networks (e.g. Italian cabina primaria)."@en ;
                   rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                   rdfs:label "Primary Substation"@en ;
                   <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/Substation> .


###  https://w3id.org/celine-eu#RedistributionResult
:RedistributionResult rdf:type owl:Class ;
                      rdfs:comment """The calculated redistribution outcome for a single member within a
    SettlementRun. Records credit balance (kWh), gross monetary value before deductions,
    the member's allocated share of community costs, and the final net amount.""" ;
                      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                      rdfs:label "Redistribution Result" ;
                      <http://www.w3.org/2004/02/skos/core#example> """ex:result_rossi a celine:RedistributionResult ;
    celine:resultFor        ex:member_rossi ;
    celine:creditBalance    \"2.1\"^^xsd:decimal ;
    celine:grossAmount      \"0.252\"^^xsd:decimal ;
    celine:costDeduction    \"0.048\"^^xsd:decimal ;
    celine:netAmount        \"0.204\"^^xsd:decimal .""" .


###  https://w3id.org/celine-eu#RegulatoryZone
:RegulatoryZone rdf:type owl:Class ;
                rdfs:comment "Administrative coverage area defined by energy regulation, e.g. the service zone of a primary substation under Italian Decreto 199/2021 (GSE perimeter)."@en ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "Regulatory Zone"@en .


###  https://w3id.org/celine-eu#Scenario
:Scenario rdf:type owl:Class ;
          rdfs:comment """Definition of assumptions, temporal scope and configuration
    for one or more simulations.""" ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "Scenario" ;
          <http://www.w3.org/2004/02/skos/core#example> """ex:sc_summer a celine:Scenario ;
    rdfs:label              \"Summer 2025 baseline\" ;
    dct:description         \"24-hour simulation with historical irradiance data.\" ;
    celine:hasTimeInterval  ex:interval_2025_summer .""" .


###  https://w3id.org/celine-eu#SecondarySubstation
:SecondarySubstation rdf:type owl:Class ;
                     rdfs:subClassOf :Substation ;
                     rdfs:comment "MV/LV substation serving end-user connection points (e.g. Italian cabina secondaria)."@en ;
                     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                     rdfs:label "Secondary Substation"@en ;
                     <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/Substation> .


###  https://w3id.org/celine-eu#SettlementRun
:SettlementRun rdf:type owl:Class ;
               rdfs:comment """Execution of the redistribution calculation for a settlement period.
    Aggregates FlexibilityCredits across all members, applies a linear conversion rate
    (kWh -> monetary), deducts shared cost voices (CostItems), and produces one
    RedistributionResult per member.""" ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "Settlement Run" ;
               <http://www.w3.org/2004/02/skos/core#example> """ex:sr_2025_q3 a celine:SettlementRun ;
    celine:settlesContext           ex:ctx1 ;
    celine:hasTimeInterval          ex:interval_q3_2025 ;
    celine:conversionRate           \"0.12\"^^xsd:decimal ;
    celine:currency                 \"EUR\" ;
    celine:hasCostItem              ex:cost_admin, ex:cost_platform_fee ;
    celine:hasRedistributionResult  ex:result_rossi, ex:result_bianchi .""" .


###  https://w3id.org/celine-eu#SharingGroup
:SharingGroup rdf:type owl:Class ;
              rdfs:comment """A subset of community members whose energy flows are accounted together
    for shared self-consumption within a single regulatory zone. Maps to the Italian
    'configurazione' under Decreto 199/2021, the French 'périmètre ACC', and analogous
    groupings in other EU member states. A connection point MUST NOT belong to more than
    one SharingGroup across all communities — the double-counting prohibition derives from
    RED II (2018/2001, Art. 22) and the Electricity Market Directive (2019/944, Art. 16)."""@en ;
              rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
              rdfs:label "Sharing Group"@en ;
              <http://www.w3.org/2004/02/skos/core#example> """ex:group_north a celine:SharingGroup ;
    rdfs:label              \"Northern area\" ;
    celine:partitionOf      ex:ctx1 ;
    celine:inRegulatoryZone ex:zone_cp_nord ;
    celine:hasTopologyNode  ex:ss_AC221E00020 ;
    celine:hasMember        ex:member_001 , ex:member_002 .""" .


###  https://w3id.org/celine-eu#Simulation
:Simulation rdf:type owl:Class ;
            rdfs:comment "Abstract simulation definition independent from execution." ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "Simulation" ;
            <http://www.w3.org/2004/02/skos/core#example> """ex:sim1 a celine:Simulation ;
    celine:hasScenario      ex:sc_summer ;
    celine:hasSimulationRun ex:run_001 .""" .


###  https://w3id.org/celine-eu#SimulationRun
:SimulationRun rdf:type owl:Class ;
               rdfs:comment "Concrete execution of a Simulation under a specific Scenario." ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               rdfs:label "Simulation Run" ;
               <http://www.w3.org/2004/02/skos/core#example> """ex:run_001 a celine:SimulationRun ;
    celine:usesDataset      ex:ds_irradiance ;
    celine:producesDataset  ex:ds_energy_forecast ;
    celine:hasKPIEvaluation ex:kpi_self_sufficiency .""" .


###  https://w3id.org/celine-eu#Substation
:Substation rdf:type owl:Class ;
            rdfs:subClassOf <https://purl.org/peco/peco-core#Asset> ;
            rdfs:comment "Abstract superclass for electrical substations in the distribution grid."@en ;
            rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
            rdfs:label "Substation"@en ;
            <http://www.w3.org/2004/02/skos/core#closeMatch> <https://ontology.tno.nl/IEC_CIM/Substation> .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/celine-eu#AdminCost
:AdminCost rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "Overhead and management costs for operating the REC."@en ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :CostType ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Administrative Cost"@en ;
           <http://www.w3.org/2004/02/skos/core#topConceptOf> :CostType .


###  https://w3id.org/celine-eu#Automated
:Automated rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "Commitment fulfilled automatically by a smart device or control system, without manual intervention from the member."@en ;
           rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :CommitmentMode ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Automated"@en ;
           <http://www.w3.org/2004/02/skos/core#topConceptOf> :CommitmentMode .


###  https://w3id.org/celine-eu#CUPS
:CUPS rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
      <http://www.w3.org/2004/02/skos/core#inScheme> :ConnectionPointIdentifierScheme ;
      <http://www.w3.org/2004/02/skos/core#note> "Spain — Código Universal de Punto de Suministro. Assigned by the distribution company to each supply point."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "CUPS"@en ;
      <http://www.w3.org/2004/02/skos/core#topConceptOf> :ConnectionPointIdentifierScheme .


###  https://w3id.org/celine-eu#CommitmentMode
:CommitmentMode rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                <http://purl.org/dc/terms/description> "Classification of how a flexibility commitment is activated."@en ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "Commitment Mode"@en ;
                <http://www.w3.org/2004/02/skos/core#hasTopConcept> :Automated ,
                                                                    :Voluntary ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Commitment Mode"@en .


###  https://w3id.org/celine-eu#ConnectionPointIdentifierScheme
:ConnectionPointIdentifierScheme rdf:type owl:NamedIndividual ,
                                          <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                 <http://purl.org/dc/terms/description> "National metering-point identifier schemes used across European energy markets."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                                 rdfs:label "Connection Point Identifier Scheme"@en ;
                                 <http://www.w3.org/2004/02/skos/core#hasTopConcept> :CUPS ,
                                                                                     :EAN ,
                                                                                     :MALO ,
                                                                                     :MPAN ,
                                                                                     :POD ,
                                                                                     :PRM ;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Connection Point Identifier Scheme"@en .


###  https://w3id.org/celine-eu#ConstraintType
:ConstraintType rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                <http://purl.org/dc/terms/description> "Classification of operational constraints on flexibility activation."@en ;
                rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                rdfs:label "Constraint Type"@en ;
                <http://www.w3.org/2004/02/skos/core#hasTopConcept> :DurationConstraint ,
                                                                    :FrequencyConstraint ,
                                                                    :NoticeConstraint ,
                                                                    :RecoveryConstraint ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Constraint Type"@en .


###  https://w3id.org/celine-eu#CostType
:CostType rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
          <http://purl.org/dc/terms/description> "Classification of cost voices within a SettlementRun."@en ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          rdfs:label "Cost Type"@en ;
          <http://www.w3.org/2004/02/skos/core#hasTopConcept> :AdminCost ,
                                                              :Debt ,
                                                              :Fee ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Cost Type"@en .


###  https://w3id.org/celine-eu#Debt
:Debt rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:comment "Outstanding obligation carried forward from a previous settlement period."@en ;
      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
      <http://www.w3.org/2004/02/skos/core#inScheme> :CostType ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Debt"@en ;
      <http://www.w3.org/2004/02/skos/core#topConceptOf> :CostType .


###  https://w3id.org/celine-eu#Dimensionless
:Dimensionless rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "Dimensionless quantity (ratio, fraction, percentage). UCUM code: 1"@en ;
               rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
               <http://www.w3.org/2004/02/skos/core#inScheme> :UnitOfMeasure ;
               <http://www.w3.org/2004/02/skos/core#notation> "1" ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Adimensionale"@it ,
                                                               "Dimensionless"@en ;
               <http://www.w3.org/2004/02/skos/core#topConceptOf> :UnitOfMeasure .


###  https://w3id.org/celine-eu#DurationConstraint
:DurationConstraint rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                    rdfs:comment "Constraint on the minimum or maximum duration of a single flexibility activation event."@en ;
                    rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :ConstraintType ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Duration Constraint"@en ;
                    <http://www.w3.org/2004/02/skos/core#topConceptOf> :ConstraintType .


###  https://w3id.org/celine-eu#EAN
:EAN rdf:type owl:NamedIndividual ,
              <http://www.w3.org/2004/02/skos/core#Concept> ;
     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
     <http://www.w3.org/2004/02/skos/core#inScheme> :ConnectionPointIdentifierScheme ;
     <http://www.w3.org/2004/02/skos/core#note> "Belgium / Netherlands — European Article Number code used to identify metering points in the Benelux energy markets."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "EAN"@en ;
     <http://www.w3.org/2004/02/skos/core#topConceptOf> :ConnectionPointIdentifierScheme .


###  https://w3id.org/celine-eu#Euro
:Euro rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:comment "Currency unit, ISO 4217 code EUR."@en ;
      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
      <http://www.w3.org/2004/02/skos/core#inScheme> :UnitOfMeasure ;
      <http://www.w3.org/2004/02/skos/core#notation> "EUR" ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Euro"@en ,
                                                      "Euro"@it ;
      <http://www.w3.org/2004/02/skos/core#topConceptOf> :UnitOfMeasure .


###  https://w3id.org/celine-eu#FedInEnergy
:FedInEnergy rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos/core#Concept> ,
                      :KPIDefinition ;
             :hasKPICalculationMethod :MethodTotal ;
             :hasKPIScopeType :ScopePOD ;
             :hasKPITemporalGranularity :GranularityPeriod ;
             :hasKPIUnit :KilowattHour ;
             :hasKPIName "Fed-In Energy" ;
             rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
             rdfs:label "Energia immessa"@it ,
                        "Fed-In Energy"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Total energy fed into the grid by a POD during the evaluation period."@en ;
             <http://www.w3.org/2004/02/skos/core#inScheme> :KPICatalog ;
             <http://www.w3.org/2004/02/skos/core#topConceptOf> :KPICatalog .


###  https://w3id.org/celine-eu#Fee
:Fee rdf:type owl:NamedIndividual ,
              <http://www.w3.org/2004/02/skos/core#Concept> ;
     rdfs:comment "Platform, service or regulatory fee charged to the community."@en ;
     rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
     <http://www.w3.org/2004/02/skos/core#inScheme> :CostType ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Fee"@en ;
     <http://www.w3.org/2004/02/skos/core#topConceptOf> :CostType .


###  https://w3id.org/celine-eu#FlexDown
:FlexDown rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ;
          rdfs:comment "Decrease community net consumption: reduce load or increase local generation."@en ;
          rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
          <http://www.w3.org/2004/02/skos/core#inScheme> :FlexibilityDirection ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Flex Down"@en ;
          <http://www.w3.org/2004/02/skos/core#topConceptOf> :FlexibilityDirection .


###  https://w3id.org/celine-eu#FlexUp
:FlexUp rdf:type owl:NamedIndividual ,
                 <http://www.w3.org/2004/02/skos/core#Concept> ;
        rdfs:comment "Increase community net consumption: increase load or reduce local generation."@en ;
        rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
        <http://www.w3.org/2004/02/skos/core#inScheme> :FlexibilityDirection ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Flex Up"@en ;
        <http://www.w3.org/2004/02/skos/core#topConceptOf> :FlexibilityDirection .


###  https://w3id.org/celine-eu#FlexibilityActivated
:FlexibilityActivated rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#Concept> ,
                               :KPIDefinition ;
                      :hasKPICalculationMethod :MethodTotal ;
                      :hasKPIScopeType :ScopeCommunity ;
                      :hasKPITemporalGranularity :GranularityPeriod ;
                      :hasKPIUnit :KilowattHour ;
                      :hasKPIName "Flexibility Activated" ;
                      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                      rdfs:label "Flessibilità attivata"@it ,
                                 "Flexibility Activated"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Total flexibility energy activated (delivered) during the evaluation period, across all commitments in scope."@en ;
                      <http://www.w3.org/2004/02/skos/core#inScheme> :KPICatalog ;
                      <http://www.w3.org/2004/02/skos/core#topConceptOf> :KPICatalog .


###  https://w3id.org/celine-eu#FlexibilityDirection
:FlexibilityDirection rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                      <http://purl.org/dc/terms/description> "Direction of the flexibility commitment relative to the community baseline."@en ;
                      rdfs:isDefinedBy <https://w3id.org/celine-eu> ;
                      rdfs:label "Flexibility Direction"@en ;
                      <http://www.w3.org/2004/02/skos/core#hasTopConcept> :FlexDown ,
                                                                          :FlexUp ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Flexibility Direction"@en .


###  https://w3id.org/celine-eu#FrequencyConstraint
