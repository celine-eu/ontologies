    { "@id": "celine:IncentiveAccrued",        "@type": ["skos:Concept", "celine:KPIDefinition"], "label": "Incentive Accrued" },
    { "@id": "celine:IncentiveMemberShare",    "@type": ["skos:Concept", "celine:KPIDefinition"], "label": "Incentive Member Share" },
