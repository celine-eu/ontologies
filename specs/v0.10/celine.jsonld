    { "@id": "celine:SimulationRun",     "@type": "owl:Class", "label": "Simulation Run" },
    { "@id": "celine:DatasetReference",  "@type": "owl:Class", "label": "Dataset Reference" },
    { "@id": "celine:KPIDefinition",     "@type": "owl:Class", "label": "KPI Definition" },
    { "@id": "celine:KPIEvaluation",     "@type": "owl:Class", "label": "KPI Evaluation" },
    { "@id": "celine:FlexibilityCommitment", "@type": "owl:Class", "label": "Flexibility Commitment" },
    { "@id": "celine:FlexibilityCredit",     "@type": "owl:Class", "label": "Flexibility Credit" },
    { "@id": "celine:SettlementRun",         "@type": "owl:Class", "label": "Settlement Run" },
