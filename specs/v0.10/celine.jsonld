  "@graph": [
    {
      "@id": "https://w3id.org/celine-eu",
      "@type": "owl:Ontology",
      "label": "CELINE Core Ontology",
      "description": "Lightweight orchestration ontology for Renewable Energy Communities and Digital Twin workflows. v0.10 adds the observable properties a REC energy dataset reports \u2014 grid import and export, self-consumed, collectively shared and virtual consumed energy, and the self-consumption ratio \u2014 as sosa:ObservableProperty individuals with qudt:hasQuantityKind, because no standard distinguishes import from export and saref:Energy is deprecated. v0.9 is a conformance fix, no new terms: the cim: prefix now binds to the IEC CIM100 namespace (http://iec.ch/TC57/CIM100#) instead of TNO's hosting URL, so the skos:closeMatch alignments to CIM resolve; celine:GridOperator aligns to cim:Organisation, cim:Company having never existed. v0.8 was a conformance fix adding skos:hasTopConcept to the CommitmentMode, FlexibilityDirection, CostType and ConstraintType schemes.",
      "dct:license": { "@id": "https://creativecommons.org/licenses/by/4.0/" }
    },
    { "@id": "celine:CommunityContext",  "@type": "owl:Class", "label": "Community Context" },
