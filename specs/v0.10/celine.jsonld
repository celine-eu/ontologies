    { "@id": "celine:FedInEnergy",             "@type": ["skos:Concept", "celine:KPIDefinition"], "label": "Fed-In Energy" },
    { "@id": "celine:LocalGenerationEnergy",   "@type": ["skos:Concept", "celine:KPIDefinition"], "label": "Local Generation Energy" },
