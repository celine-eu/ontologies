    { "@id": "celine:GridImportEnergy",        "@type": "sosa:ObservableProperty", "label": "Grid import energy",        "hasQuantityKind": "quantitykind:Energy",           "rdfs:seeAlso": { "@id": "celine:WithdrawnEnergy" } },
    { "@id": "celine:GridExportEnergy",        "@type": "sosa:ObservableProperty", "label": "Grid export energy",        "hasQuantityKind": "quantitykind:Energy",           "rdfs:seeAlso": { "@id": "celine:FedInEnergy" } },
    { "@id": "celine:SelfConsumedEnergy",      "@type": "sosa:ObservableProperty", "label": "Self-consumed energy",      "hasQuantityKind": "quantitykind:Energy" },
    { "@id": "celine:CollectivelySharedEnergy","@type": "sosa:ObservableProperty", "label": "Collectively shared energy","hasQuantityKind": "quantitykind:Energy",           "rdfs:seeAlso": { "@id": "celine:SharedEnergy" } },
    { "@id": "celine:VirtualConsumedEnergy",   "@type": "sosa:ObservableProperty", "label": "Virtual consumed energy",   "hasQuantityKind": "quantitykind:Energy",           "rdfs:seeAlso": { "@id": "celine:SharedEnergyMemberShare" } },
    { "@id": "celine:SelfConsumptionRatio",    "@type": "sosa:ObservableProperty", "label": "Self-consumption ratio",    "hasQuantityKind": "quantitykind:DimensionlessRatio", "rdfs:seeAlso": { "@id": "celine:SelfConsumptionRate" } },

