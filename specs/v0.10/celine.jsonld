    { "@id": "celine:Kilowatt",                "@type": "skos:Concept", "skos:prefLabel": "Kilowatt", "skos:notation": "kW" },
    { "@id": "celine:Euro",                    "@type": "skos:Concept", "skos:prefLabel": "Euro", "skos:notation": "EUR" },
