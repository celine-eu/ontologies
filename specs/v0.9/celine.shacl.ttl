################################################################################
# TIME interval minimal constraints (carried from v0.3)
################################################################################

celine:TimeIntervalShape
    a sh:NodeShape ;
    sh:targetClass time:Interval ;
    rdfs:label "time:Interval minimal constraints" ;
    sh:property [
        sh:path time:hasBeginning ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path time:hasEnd ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:or (
        [ sh:property [ sh:path time:hasBeginning ; sh:minCount 1 ] ]
        [ sh:property [ sh:path time:hasEnd      ; sh:minCount 1 ] ]
    ) ;
    rdfs:comment "At least one of time:hasBeginning or time:hasEnd must be present." .

################################################################################
# SKOS Concept Scheme shapes — Flexibility & Settlement  (back-ported from v0.4)
#
# CommitmentMode, FlexibilityDirection, CostType, ConstraintType were carried
# forward without shapes; adding them here for parity with the v0.5+ pattern.
################################################################################

celine:CommitmentModeSchemeShape
    a sh:NodeShape ;
    sh:targetNode celine:CommitmentMode ;
    rdfs:label "CommitmentMode scheme constraints" ;
    sh:property [
        sh:path skos:hasTopConcept ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] .

celine:CommitmentModeConceptShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this skos:inScheme <https://w3id.org/celine-eu#CommitmentMode> .
            }
        """ ;
    ] ;
    rdfs:label "CommitmentMode concept member constraints" ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue skos:Concept ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue celine:CommitmentMode ;
    ] .

celine:FlexibilityDirectionSchemeShape
    a sh:NodeShape ;
    sh:targetNode celine:FlexibilityDirection ;
    rdfs:label "FlexibilityDirection scheme constraints" ;
    sh:property [
