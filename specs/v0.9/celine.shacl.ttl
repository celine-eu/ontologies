################################################################################
# KPI Evaluation shapes  (modified in v0.5)
################################################################################

celine:KPIEvaluationShape
    a sh:NodeShape ;
    sh:targetClass celine:KPIEvaluation ;
    rdfs:label "KPIEvaluation constraints" ;
    sh:property [
        sh:path celine:hasKPIDefinition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class celine:KPIDefinition ;
    ] ;
    sh:property [
        sh:path celine:hasKPIValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
        ) ;
    ] ;
    sh:property [
        sh:path celine:hasEvaluationTimeInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class time:Interval ;
    ] ;
    sh:property [
        sh:path celine:hasEvaluatedScope ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path celine:hasInputObservation ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:class sosa:Observation ;
    ] ;
    sh:property [
        sh:path celine:hasInputKPIEvaluation ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:class celine:KPIEvaluation ;
    ] .

