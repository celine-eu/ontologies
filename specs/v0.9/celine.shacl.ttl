        """ ;
    ] ;
    rdfs:label "FlexibilityDirection concept member constraints" ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue skos:Concept ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue celine:FlexibilityDirection ;
    ] .

