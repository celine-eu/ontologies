        sh:path celine:hasKPIScopeType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path celine:hasKPICalculationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path celine:hasKPITemporalGranularity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path celine:hasKPIUnit ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path celine:hasKPIDescription ;
        sh:minCount 0 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path celine:hasKPIFormula ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
