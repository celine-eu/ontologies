# Flexibility Request shapes  (new in v0.6)
################################################################################

celine:FlexibilityRequestShape
    a sh:NodeShape ;
    sh:targetClass celine:FlexibilityRequest ;
    rdfs:label "FlexibilityRequest constraints" ;
    sh:property [
        sh:path celine:requestedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class peco:Agent ;
    ] ;
    sh:property [
        sh:path celine:hasFlexibilityDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path celine:requestedFlexibility ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
    ] ;
    sh:property [
        sh:path celine:hasTimeInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class time:Interval ;
    ] ;
    sh:property [
        sh:path celine:hasRequestStatus ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path celine:resultsInCommitment ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:class celine:FlexibilityCommitment ;
    ] .

