################################################################################
# Member extension shape  (new in v0.6)
#
# Constrains the three new properties defined on peco:Energy_community_member.
# hasDeliveryPoint is required by the NoDoubleCountingConstraint SPARQL path.
################################################################################

celine:CelineMemberShape
    a sh:NodeShape ;
    sh:targetClass peco:Energy_community_member ;
    rdfs:label "CELINE member extension constraints" ;
    sh:property [
        sh:path celine:hasMemberRole ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path celine:hasMemberStatus ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path celine:hasDeliveryPoint ;
        sh:nodeKind sh:IRI ;
        sh:class celine:ConnectionPoint ;
        sh:minCount 0 ;
    ] .
