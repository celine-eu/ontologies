celine:KPIScopeConceptShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this skos:inScheme <https://w3id.org/celine-eu#KPIScope> .
            }
        """ ;
    ] ;
    rdfs:label "KPIScope concept member constraints" ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue skos:Concept ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue celine:KPIScope ;
    ] .

celine:KPICalculationMethodConceptShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
