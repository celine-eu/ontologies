    sh:property [
        sh:path celine:creditFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class celine:FlexibilityCommitment ;
    ] ;
    sh:property [
        sh:path celine:creditAmount ;
        sh:minCount 1 ;
